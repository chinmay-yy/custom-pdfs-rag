       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 463}, page_content='K Means Clustering Algorithm\\nFor Premium Courses of AI & Data Science, Contact us - 7880113112'),\n",
