       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 232}, page_content=''),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 233}, page_content=''),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 234}, page_content=\"Unit 2: Variables & Data Types\\nQ: Swap two variables\\nA: a,b=10,20 a,b=b,a print(a,b)\\nQ: Check datatype\\nA: x=input() print(type(x))\\nQ: Convert float to int\\nA: x=10.5 print(int(x))\\nQ: Sum of two floats\\nA: a=float(input()) b=float(input()) print(a+b)\\nQ: Multiple assignment\\nA: a=b=c=5 print(a,b,c)\\nUnit 3: Operators\\nQ: Even or odd\\nA: n=int(input()) print(n%2==0)\\nQ: Largest of 3\\nA: print(max(1,5,3))\\nQ: Divisible by 5 and 11\\nA: n=int(input()) print(n%5==0 and n%11==0)\\nQ: Power\\nA: print(2**3)\\nQ: Bitwise AND\\nA: print(5&3)\\nUnit 4: Built-in Functions\\nQ: Length\\nA: print(len('hello'))\\nQ: Sum\\nA: print(sum([1,2,3]))\\nQ: Max\\nA: print(max([1,5,3]))\\nQ: Sort\\nA: print(sorted([3,1,2]))\\nQ: Type casting\\nA: print(str(10))\\nUnit 5: Control Flow\\nPractice Questions\"),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 235}, page_content=\"Q: Positive or negative\\nA: n=int(input()) print('Positive' if n>0 else 'Negative')\\nQ: Grade\\nA: marks=80 print('A' if marks>=75 else 'B')\\nQ: Leap year\\nA: year=2024 print(year%4==0)\\nQ: Nested if\\nA: x=10 if x>5: if x<15: print('OK')\\nQ: Vowel check\\nA: ch='a' print(ch in 'aeiou')\\nUnit 6: Loops\\nQ: Print 1-10\\nA: for i in range(1,11): print(i)\\nQ: Sum n numbers\\nA: n=5 print(sum(range(1,n+1)))\\nQ: Reverse number\\nA: n=123 print(str(n)[::-1])\\nQ: Factorial\\nA: f=1 for i in range(1,6): f*=i print(f)\\nQ: While loop\\nA: i=1 while i<=5: print(i) i+=1\\nUnit 7: Functions\\nQ: Simple function\\nA: def f(): print('Hi') f()\\nQ: Add function\\nA: def add(a,b): return a+b print(add(2,3))\\nQ: Default arg\\nA: def f(x=10): print(x) f()\\nQ: Lambda\\nA: sq=lambda x:x*x print(sq(4))\\nQ: Recursion\\nA: def fact(n): return 1 if n==1 else n*fact(n-1) print(fact(5))\\nUnit 8: Strings\\nQ: Reverse string\\nA: s='hello' print(s[::-1])\"),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 236}, page_content=\"Q: Count vowels\\nA: s='hello' print(sum(1 for i in s if i in 'aeiou'))\\nQ: Uppercase\\nA: print('hi'.upper())\\nQ: Palindrome\\nA: s='madam' print(s==s[::-1])\\nQ: Replace\\nA: print('hi'.replace('h','y'))\\nUnit 9: Lists\\nQ: Append\\nA: l=[1,2] l.append(3)\\nQ: Remove\\nA: l=[1,2,3] l.remove(2)\\nQ: List comprehension\\nA: [i*i for i in range(5)]\\nQ: Max\\nA: print(max([1,5,3]))\\nQ: Reverse\\nA: l=[1,2,3] l.reverse()\\nUnit 10: Tuples\\nQ: Create tuple\\nA: t=(1,2,3)\\nQ: Access\\nA: print(t[1])\\nQ: Count\\nA: print(t.count(2))\\nQ: Convert\\nA: tuple([1,2])\\nQ: Unpacking\\nA: a,b=(1,2)\\nUnit 11: Dictionary\\nQ: Create\\nA: d={'a':1}\\nQ: Access\\nA: print(d['a'])\"),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 237}, page_content=\"Q: Add key\\nA: d['b']=2\\nQ: Loop\\nA: for k,v in d.items(): print(k,v)\\nQ: Get\\nA: print(d.get('a'))\\nUnit 12: Set\\nQ: Create\\nA: s={1,2,3}\\nQ: Add\\nA: s.add(4)\\nQ: Remove\\nA: s.remove(2)\\nQ: Union\\nA: print({1,2}|{2,3})\\nQ: Intersection\\nA: print({1,2}&{2,3})\\nUnit 13: NumPy\\nQ: Array\\nA: import numpy as np np.array([1,2,3])\\nQ: Shape\\nA: arr=np.array([1,2,3]) print(arr.shape)\\nQ: Zeros\\nA: np.zeros((2,2))\\nQ: Mean\\nA: np.mean([1,2,3])\\nQ: Add\\nA: arr+5\\nUnit 14: Pandas\\nQ: DataFrame\\nA: import pandas as pd df=pd.DataFrame({'A':[1,2]})\\nQ: Head\\nA: df.head()\\nQ: Column\\nA: df['A']\"),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 238}, page_content=\"Q: Describe\\nA: df.describe()\\nQ: Filter\\nA: df[df['A']>1]\\nUnit 15: Matplotlib\\nQ: Line plot\\nA: import matplotlib.pyplot as plt plt.plot([1,2],[3,4]);plt.show()\\nQ: Title\\nA: plt.title('Graph')\\nQ: Labels\\nA: plt.xlabel('X');plt.ylabel('Y')\\nQ: Bar\\nA: plt.bar([1,2],[3,4])\\nQ: Hist\\nA: plt.hist([1,2,2,3])\\nUnit 16: Seaborn\\nQ: Load dataset\\nA: import seaborn as sns df=sns.load_dataset('tips')\\nQ: Scatter\\nA: sns.scatterplot(x='total_bill',y='tip',data=df)\\nQ: Boxplot\\nA: sns.boxplot(x='day',y='total_bill',data=df)\\nQ: Heatmap\\nA: sns.heatmap(df.corr())\\nQ: Pairplot\\nA: sns.pairplot(df)\"),\n",
