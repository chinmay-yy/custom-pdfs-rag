       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 445}, page_content='Decision Tree Algorithm\\nFor Premium Courses of AI & Data Science, Contact us - 7880113112'),\n",
       " Document(metadata={'producer': 'iLovePDF', 'creator': '', 'creationdate': '', 'source': '../data/pdf/AIEngineer.pdf', 'file_path': '../data/pdf/AIEngineer.pdf', 'total_pages': 529, 'format': 'PDF 1.7', 'title': '', 'author': '', 'subject': '', 'keywords': '', 'moddate': '2026-06-17T05:56:46+00:00', 'trapped': '', 'modDate': 'D:20260617055646Z', 'creationDate': '', 'page': 446}, page_content='Decision Tree Algorithm\\nFor Premium Courses of AI & Data Science, Contact us - 7880113112\\n1. Entropy = 0 (Minimum)\\nIska matlab hai ki data 100% Pure hai. Koi randomness ya \\ndisorder nahi hai.\\n2. Entropy = 1 (Maximum)\\nIska matlab hai ki data Perfectly Impure hai. Disorder sabse \\nzyada hai.\\n3. Entropy between 0 and 1\\nAgar data thoda mixed hai, toh value 0 aur 1 ke beech \\naayegi.'),\n",
